---
const {
  title = "蓝破碎半圆",
  description = "一个 AI 时代技术决策者的判断笔记。",
  pageClass = "",
  image = "/images/002-chopping-vs-herding-cover.png",
  type = "website",
} = Astro.props;

const siteTitle = title === "蓝破碎半圆" ? title : `${title} | 蓝破碎半圆`;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const canonical = new URL(Astro.url.pathname, "https://zenine.github.io").toString();
const imageUrl = new URL(withBase(image), "https://zenine.github.io").toString();
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="蓝破碎半圆 RSS" href={withBase("rss.xml")} />
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />
    <link rel="icon" href={withBase("favicon.ico")} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content="蓝破碎半圆" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <slot name="head" />
    <title>{siteTitle}</title>
  </head>
  <body class={pageClass}>
    <header class="site-header">
      <a class="brand" href={base}>
        <span class="brand-mark" aria-hidden="true"></span>
        <span>
          <strong>蓝破碎半圆</strong>
          <small>判断笔记</small>
        </span>
      </a>
      <nav aria-label="主导航">
        <a href={withBase("articles/")}>文章</a>
        <a href={withBase("categories/")}>分类</a>
        <a href={withBase("collections/")}>合集</a>
        <a href={withBase("search/")}>检索</a>
        <span class="wechat-nav">
          <a href="http://weixin.qq.com/r/mp/njrl-WTEHTlirSCe92_M">公众号</a>
          <span class="wechat-qr" role="tooltip" aria-label="公众号二维码">
            <img src={withBase("images/wechat-qr.jpg")} alt="公众号二维码" width="172" height="172" />
          </span>
        </span>
      </nav>
    </header>
    <slot />
    <footer class="site-footer">
      <div>
        <strong>蓝破碎半圆</strong>
        <span>在破碎信息里，留下判断的现场。</span>
      </div>
      <nav aria-label="页脚导航">
        <a href={withBase("rss.xml")}>RSS</a>
        <a href={withBase("search/")}>检索</a>
        <a href={withBase("categories/")}>分类</a>
      </nav>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f6f8f5;
    --paper-2: #e6edf0;
    --ink: #121820;
    --muted: #5c6670;
    --line: rgba(18, 24, 32, 0.14);
    --blue: #1268f3;
    --cyan: #5cd6e8;
    --ochre: #a6602a;
    --green: #267867;
    --deep: #081724;
    --max: 1120px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: "Songti SC", "Noto Serif CJK SC", "Source Han Serif SC", Georgia, serif;
    text-rendering: optimizeLegibility;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      linear-gradient(90deg, rgba(18, 24, 32, 0.035) 1px, transparent 1px) 0 0 / 34px 34px,
      linear-gradient(rgba(18, 24, 32, 0.03) 1px, transparent 1px) 0 0 / 34px 34px,
      radial-gradient(circle at 16% 0%, rgba(18, 104, 243, 0.12), transparent 28rem),
      radial-gradient(circle at 92% 18%, rgba(38, 120, 103, 0.12), transparent 24rem),
      var(--paper);
  }

  a {
    color: inherit;
    text-decoration-color: rgba(31, 121, 255, 0.45);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  img {
    display: block;
    max-width: 100%;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--max);
    margin: 0 auto;
    padding: 1.3rem 1.2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .brand-mark {
    width: 2.15rem;
    height: 2.15rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    border-right-color: transparent;
    border-bottom-color: var(--blue);
    box-shadow: inset 0 0 0 5px rgba(31, 121, 255, 0.08);
  }

  .brand strong,
  .brand small {
    display: block;
    line-height: 1.1;
  }

  .brand strong {
    font-size: 1rem;
  }

  .brand small,
  nav a {
    color: var(--muted);
    font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 0.82rem;
  }

  nav {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  nav a {
    text-decoration: none;
  }

  .wechat-nav {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .wechat-nav::after {
    position: absolute;
    top: 100%;
    right: 0;
    width: 12rem;
    height: 0.8rem;
    content: "";
  }

  .wechat-qr {
    position: absolute;
    top: calc(100% + 0.75rem);
    right: 0;
    z-index: 10;
    width: 12rem;
    padding: 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(246, 248, 245, 0.98);
    box-shadow: 0 16px 38px rgba(10, 27, 46, 0.18);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.25rem);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
  }

  .wechat-qr::before {
    position: absolute;
    top: -0.45rem;
    right: 1.1rem;
    width: 0.8rem;
    height: 0.8rem;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    background: rgba(246, 248, 245, 0.98);
    content: "";
    transform: rotate(45deg);
  }

  .wechat-qr img {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .wechat-nav:hover .wechat-qr,
  .wechat-nav:focus-within .wechat-qr {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 1.2rem;
  }

  .kicker {
    color: var(--blue);
    font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
  }

  .site-footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: var(--max);
    margin: 0 auto;
    padding: 3rem 1.2rem 2rem;
    border-top: 1px solid var(--line);
  }

  .site-footer strong,
  .site-footer span {
    display: block;
  }

  .site-footer span {
    margin-top: 0.35rem;
    color: var(--muted);
    font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 0.86rem;
  }

  @media (max-width: 640px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding-top: 1rem;
    }

    nav,
    .site-footer {
      flex-wrap: wrap;
    }

    .site-footer {
      flex-direction: column;
    }

    .wechat-qr {
      right: auto;
      left: 0;
    }

    .wechat-qr::before {
      right: auto;
      left: 1.1rem;
    }
  }
</style>
