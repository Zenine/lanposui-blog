---
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const title = frontmatter.title;
const description = frontmatter.description;
const date = new Date(frontmatter.date).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const issueLabel =
  Number(frontmatter.issue) > 0 && Number(frontmatter.issue) < 1000
    ? `第 ${String(frontmatter.issue).padStart(3, "0")} 期`
    : "过往文章";
---

<BaseLayout title={title} description={description} pageClass="article-page">
  <main class="article-shell">
    <article>
      <header class="article-hero">
        <p class="kicker">{issueLabel} · {frontmatter.category}</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
        <div class="meta">
          <time datetime={frontmatter.date}>{date}</time>
          {frontmatter.wechat && <a href={frontmatter.wechat}>公众号原文</a>}
        </div>
        {frontmatter.cover && <img class="cover" src={frontmatter.cover} alt="" loading="eager" />}
      </header>
      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .article-shell {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1.2rem 6rem;
  }

  .article-hero {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    max-width: 760px;
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .description {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.14rem;
    line-height: 1.85;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.5rem 0 2rem;
    color: var(--muted);
    font-family: "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 0.9rem;
  }

  .cover {
    width: 100%;
    margin: 1.5rem 0 3rem;
    border: 1px solid rgba(20, 23, 26, 0.22);
  }

  .prose {
    font-size: 1.08rem;
    line-height: 2.05;
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 1.65rem;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .prose :global(p) {
    margin: 1rem 0;
  }

  .prose :global(strong) {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: rgba(31, 121, 255, 0.32);
    text-decoration-thickness: 0.42em;
    text-underline-offset: -0.18em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin: 0.35rem 0;
  }

  .prose :global(img) {
    margin: 2rem auto;
    border: 1px solid rgba(20, 23, 26, 0.16);
  }

  .prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(code) {
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.46);
    font-size: 0.92em;
  }
</style>
