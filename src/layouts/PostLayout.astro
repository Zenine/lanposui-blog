---
import BaseLayout from "./BaseLayout.astro";
import { absoluteUrl, getRelatedPosts, imageDims, publishInstant, site, sortedPosts } from "../data/blog";

const { frontmatter, headings = [], ogImage } = Astro.props;
const title = frontmatter.title;
const description = frontmatter.description;
const date = new Date(frontmatter.date).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const issueLabel =
  Number(frontmatter.issue) > 0 && Number(frontmatter.issue) < 1000
    ? `第 ${String(frontmatter.issue).padStart(3, "0")} 期`
    : "过往文章";
const currentPost = sortedPosts.find(post => post.title === title);
const relatedPosts = currentPost ? getRelatedPosts(currentPost) : [];
const body = typeof Astro.props.body === "string" ? Astro.props.body : "";
const readingMinutes =
  body.length > 0
    ? Math.max(1, Math.round(body.replace(/\s+/g, "").length / 400))
    : 0;
const toc = (headings as { depth: number; slug: string; text: string }[]).filter(
  heading => heading.depth === 2 || heading.depth === 3,
);
const coverDims = frontmatter.cover ? imageDims(frontmatter.cover) : undefined;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const pageImage = ogImage ?? currentPost?.cover;
const shareUrl = currentPost ? absoluteUrl(currentPost.href) : site.url;
const jsonLd = currentPost
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: frontmatter.date,
      dateModified: frontmatter.updated ?? frontmatter.date,
      inLanguage: "zh-CN",
      author: {
        "@type": "Person",
        name: site.author,
        url: "https://github.com/Zenine",
      },
      mainEntityOfPage: absoluteUrl(currentPost.href),
      image: currentPost.cover ? absoluteUrl(currentPost.cover) : undefined,
      articleSection: currentPost.category,
      keywords: currentPost.tags.join(", "),
    }
  : undefined;
const breadcrumbLd = currentPost
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "首页", item: absoluteUrl("") },
        {
          "@type": "ListItem",
          position: 2,
          name: currentPost.category,
          item: absoluteUrl(`categories/${currentPost.categorySlug}/`),
        },
        { "@type": "ListItem", position: 3, name: title, item: absoluteUrl(currentPost.href) },
      ],
    }
  : undefined;
---

<BaseLayout title={title} description={description} pageClass="article-page" image={pageImage} type="article">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  {breadcrumbLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />}
  <main class="article-shell">
    <article>
      <header class="article-hero">
        <p class="kicker">{issueLabel} · {frontmatter.category}</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
        <div class="meta">
          <time datetime={frontmatter.date}>{date}</time>
          {readingMinutes > 0 && <span>约 {readingMinutes} 分钟</span>}
          {frontmatter.wechat && <a href={frontmatter.wechat}>公众号原文</a>}
        </div>
        {frontmatter.cover && (
          <img
            class="cover"
            src={frontmatter.cover}
            alt=""
            loading="eager"
            width={coverDims?.width}
            height={coverDims?.height}
          />
        )}
      </header>
      {toc.length > 0 && (
        <details class="toc-inline">
          <summary>本文目录（{toc.length} 节）</summary>
          <ol class="toc-list">
            {toc.map(heading => (
              <li class={heading.depth === 3 ? "d3" : undefined}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </details>
      )}
      <div class="article-body">
        <div class="prose">
          <slot />
        </div>
        {toc.length > 0 && (
          <nav class="toc" aria-label="本文目录">
            <div class="toc-inner">
              <p class="kicker">目录</p>
              <ol class="toc-list">
                {toc.map(heading => (
                  <li class={heading.depth === 3 ? "d3" : undefined}>
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )}
      </div>
      <aside
        class="article-share"
        aria-label="分享本文"
        data-share-title={title}
        data-share-text={description}
        data-share-url={shareUrl}
      >
        <p class="kicker">Share</p>
        <div class="share-actions">
          <button type="button" data-share-copy>复制链接</button>
          <button type="button" data-share-native>分享</button>
          <a href={frontmatter.wechat ?? withBase("images/wechat-qr.jpg")}>
            公众号
          </a>
        </div>
      </aside>
      {relatedPosts.length > 0 && (
        <aside class="related" aria-labelledby="related-title">
          <p class="kicker">Related</p>
          <h2 id="related-title">继续读相关判断</h2>
          <div>
            {relatedPosts.map(post => (
              <a href={withBase(post.href)} data-publish-at={publishInstant(post)}>
                <strong>{post.title}</strong>
                <span>{post.description}</span>
              </a>
            ))}
          </div>
        </aside>
      )}
    </article>
  </main>
  <div class="progress-arc" aria-hidden="true">
    <svg viewBox="0 0 56 31">
      <path
        class="track"
        d="M4 28 A 24 24 0 0 1 52 28"
        pathLength="100"
        fill="none"
        stroke="var(--line)"
        stroke-width="3"
        stroke-dasharray="12 4 20 5 16 4 12 6 10 11"
      />
      <path
        class="fill"
        d="M4 28 A 24 24 0 0 1 52 28"
        pathLength="100"
        fill="none"
        stroke="var(--blue)"
        stroke-width="3"
        stroke-dasharray="0 100"
      />
    </svg>
  </div>
</BaseLayout>

<style>
  .article-shell {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1.2rem 6rem;
  }

  .article-hero {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    max-width: 760px;
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .description {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.14rem;
    line-height: 1.85;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.5rem 0 2rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.9rem;
  }

  .cover {
    width: 100%;
    height: auto;
    aspect-ratio: 1.82;
    object-fit: contain;
    background: var(--paper);
    margin: 1.5rem 0 3rem;
    border: 1px solid var(--line);
  }

  .toc-inline {
    margin: 0 0 2.5rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--card);
  }

  .toc-inline summary {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.88rem;
    cursor: pointer;
  }

  .toc-inline[open] summary {
    margin-bottom: 0.6rem;
    color: var(--ink);
  }

  .toc-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc-list a {
    display: flex;
    align-items: baseline;
    padding: 0.18rem 0;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.86rem;
    line-height: 1.55;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .toc-list a:hover {
    color: var(--blue);
  }

  .toc-list .d3 a {
    padding-left: 1.1rem;
  }

  .toc-list a::before {
    flex: none;
    width: 1em;
    height: 0.52em;
    margin-right: 0.4em;
    background: var(--arc-tick) no-repeat center / contain;
    content: "";
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .toc-list a[aria-current="true"] {
    color: var(--blue);
    font-weight: 700;
  }

  .toc-list a[aria-current="true"]::before {
    opacity: 1;
  }

  /* 宽屏右侧 sticky 目录，窄屏只在文首展示折叠目录 */
  .toc {
    display: none;
  }

  @media (min-width: 1200px) {
    .article-body {
      position: relative;
    }

    .toc {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(100% + 2.5rem);
      display: block;
      width: 14rem;
    }

    .toc-inner {
      position: sticky;
      top: 5rem;
      max-height: calc(100vh - 7rem);
      padding-left: 1.2rem;
      border-left: 1px solid var(--line);
      overflow-y: auto;
    }

    .toc-inline {
      display: none;
    }
  }

  .progress-arc {
    position: fixed;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 20;
    width: 52px;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 0 6px var(--paper));
    transition: opacity 200ms ease;
  }

  .progress-arc.visible {
    opacity: 1;
  }

  .prose {
    font-size: 1.08rem;
    line-height: 2.05;
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 1.65rem;
    line-height: 1.35;
    letter-spacing: 0;
    scroll-margin-top: 5rem;
  }

  .prose :global(h3) {
    scroll-margin-top: 5rem;
  }

  .prose :global(.heading-anchor) {
    margin-left: 0.4em;
    color: var(--blue);
    text-decoration: none;
    opacity: 0;
    transition: opacity 160ms ease;
  }

  .prose :global(.anchor-icon) {
    width: 1.05em;
    height: 0.53em;
    vertical-align: -0.05em;
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  .prose :global(p) {
    margin: 1rem 0;
  }

  .prose :global(strong) {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--blue) 22%, transparent);
    text-decoration-thickness: 0.42em;
    text-underline-offset: -0.18em;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.85rem 1.2rem;
    border-left: 3px solid color-mix(in srgb, var(--blue) 55%, transparent);
    background: var(--card);
    color: var(--muted);
  }

  .prose :global(blockquote p) {
    margin: 0.4rem 0;
  }

  .prose :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.94em;
    line-height: 1.7;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--card);
    font-family: var(--sans);
    font-size: 0.86em;
  }

  .prose :global(figcaption) {
    margin-top: -1.2rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.85rem;
    text-align: center;
  }

  .prose :global(pre) {
    position: relative;
    margin: 2rem 0;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    background: var(--card);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.88em;
    line-height: 1.7;
  }

  .prose :global(pre.astro-code) {
    background-color: var(--card) !important;
  }

  .prose :global(.copy-code) {
    position: absolute;
    top: 0.55rem;
    right: 0.55rem;
    padding: 0.22rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card-solid);
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.72rem;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .prose :global(pre:hover .copy-code),
  .prose :global(.copy-code:focus-visible),
  .prose :global(.copy-code.copied) {
    opacity: 1;
  }

  .prose :global(.copy-code:hover),
  .prose :global(.copy-code.copied) {
    border-color: color-mix(in srgb, var(--blue) 55%, transparent);
    color: var(--blue);
  }

  /* shiki 双主题：跟随手动主题，系统态由媒体查询兜底；深色代码底走 --deep */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .prose :global(pre.astro-code) {
      background-color: var(--deep) !important;
    }

    :root:not([data-theme="light"]) .prose :global(pre.astro-code),
    :root:not([data-theme="light"]) .prose :global(pre.astro-code span) {
      color: var(--shiki-dark) !important;
    }
  }

  [data-theme="dark"] .prose :global(pre.astro-code) {
    background-color: var(--deep) !important;
  }

  [data-theme="dark"] .prose :global(pre.astro-code),
  [data-theme="dark"] .prose :global(pre.astro-code span) {
    color: var(--shiki-dark) !important;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin: 0.35rem 0;
  }

  .prose :global(img) {
    height: auto;
    margin: 2rem auto;
    border: 1px solid var(--line);
  }

  .prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(code) {
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--line);
    background: var(--card);
    font-family: var(--mono);
    font-size: 0.92em;
  }

  .article-share {
    margin-top: 3.2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .share-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.8rem;
  }

  .share-actions button,
  .share-actions a {
    padding: 0.52rem 0.74rem;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    font-family: var(--sans);
    font-size: 0.84rem;
    line-height: 1.2;
    text-decoration: none;
    cursor: pointer;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease;
  }

  .share-actions button:hover,
  .share-actions a:hover,
  .share-actions button.copied {
    border-color: color-mix(in srgb, var(--blue) 55%, transparent);
    color: var(--blue);
  }

  .related {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    margin: 0.45rem 0 1.2rem;
    font-size: 1.6rem;
  }

  .related div {
    display: grid;
    gap: 0.9rem;
  }

  .related a {
    padding: 1.1rem;
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
    transition: border-color 160ms ease;
  }

  .related a:hover {
    border-color: color-mix(in srgb, var(--blue) 55%, transparent);
  }

  .related strong,
  .related span {
    display: block;
  }

  .related strong {
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .related span {
    margin-top: 0.45rem;
    color: var(--muted);
    line-height: 1.7;
  }
</style>
