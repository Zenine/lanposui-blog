---
import BaseLayout from "./BaseLayout.astro";
import { absoluteUrl, getRelatedPosts, sortedPosts } from "../data/blog";

const { frontmatter } = Astro.props;
const title = frontmatter.title;
const description = frontmatter.description;
const date = new Date(frontmatter.date).toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
const issueLabel =
  Number(frontmatter.issue) > 0 && Number(frontmatter.issue) < 1000
    ? `第 ${String(frontmatter.issue).padStart(3, "0")} 期`
    : "过往文章";
const currentPost = sortedPosts.find(post => post.title === title);
const relatedPosts = currentPost ? getRelatedPosts(currentPost) : [];
const body = typeof Astro.props.body === "string" ? Astro.props.body : "";
const readingMinutes =
  body.length > 0
    ? Math.max(1, Math.round(body.replace(/\s+/g, "").length / 400))
    : 0;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const jsonLd = currentPost
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: title,
      description,
      datePublished: frontmatter.date,
      author: {
        "@type": "Person",
        name: "Azen",
      },
      mainEntityOfPage: absoluteUrl(currentPost.href),
      image: currentPost.cover ? absoluteUrl(currentPost.cover) : undefined,
      articleSection: currentPost.category,
      keywords: currentPost.tags.join(", "),
    }
  : undefined;
---

<BaseLayout title={title} description={description} pageClass="article-page" image={currentPost?.cover} type="article">
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <main class="article-shell">
    <article>
      <header class="article-hero">
        <p class="kicker">{issueLabel} · {frontmatter.category}</p>
        <h1>{title}</h1>
        <p class="description">{description}</p>
        <div class="meta">
          <time datetime={frontmatter.date}>{date}</time>
          {readingMinutes > 0 && <span>约 {readingMinutes} 分钟</span>}
          {frontmatter.wechat && <a href={frontmatter.wechat}>公众号原文</a>}
        </div>
        {frontmatter.cover && <img class="cover" src={frontmatter.cover} alt="" loading="eager" />}
      </header>
      <div class="prose">
        <slot />
      </div>
      {relatedPosts.length > 0 && (
        <aside class="related" aria-labelledby="related-title">
          <p class="kicker">Related</p>
          <h2 id="related-title">继续读相关判断</h2>
          <div>
            {relatedPosts.map(post => (
              <a href={withBase(post.href)}>
                <strong>{post.title}</strong>
                <span>{post.description}</span>
              </a>
            ))}
          </div>
        </aside>
      )}
    </article>
  </main>
  <div class="progress-arc" aria-hidden="true">
    <svg viewBox="0 0 56 31">
      <path
        class="track"
        d="M4 28 A 24 24 0 0 1 52 28"
        pathLength="100"
        fill="none"
        stroke="var(--line)"
        stroke-width="3"
        stroke-dasharray="12 4 20 5 16 4 12 6 10 11"
      />
      <path
        class="fill"
        d="M4 28 A 24 24 0 0 1 52 28"
        pathLength="100"
        fill="none"
        stroke="var(--blue)"
        stroke-width="3"
        stroke-dasharray="0 100"
      />
    </svg>
  </div>
  <script>
    const shell = document.querySelector(".progress-arc");
    const fill = shell?.querySelector(".fill");
    if (shell instanceof HTMLElement && fill) {
      const update = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - window.innerHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 1;
        fill.setAttribute("stroke-dasharray", `${(p * 100).toFixed(2)} 100`);
        shell.classList.toggle("visible", p > 0.02);
      };
      addEventListener("scroll", update, { passive: true });
      addEventListener("resize", update);
      update();
    }
  </script>
</BaseLayout>

<style>
  .article-shell {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1.2rem 6rem;
  }

  .article-hero {
    border-top: 1px solid var(--line);
    padding-top: 2rem;
  }

  h1 {
    margin: 0.5rem 0 1rem;
    max-width: 760px;
    font-size: clamp(2.4rem, 7vw, 5.6rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .description {
    max-width: 680px;
    color: var(--muted);
    font-size: 1.14rem;
    line-height: 1.85;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin: 1.5rem 0 2rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.9rem;
  }

  .cover {
    width: 100%;
    margin: 1.5rem 0 3rem;
    border: 1px solid var(--line);
  }

  .progress-arc {
    position: fixed;
    right: 1rem;
    bottom: 0.9rem;
    z-index: 20;
    width: 52px;
    opacity: 0;
    pointer-events: none;
    filter: drop-shadow(0 0 6px var(--paper));
    transition: opacity 200ms ease;
  }

  .progress-arc.visible {
    opacity: 1;
  }

  .prose {
    font-size: 1.08rem;
    line-height: 2.05;
  }

  .prose :global(h2) {
    margin: 3.5rem 0 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: 1.65rem;
    line-height: 1.35;
    letter-spacing: 0;
  }

  .prose :global(p) {
    margin: 1rem 0;
  }

  .prose :global(strong) {
    font-weight: 800;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--blue) 22%, transparent);
    text-decoration-thickness: 0.42em;
    text-underline-offset: -0.18em;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.85rem 1.2rem;
    border-left: 3px solid color-mix(in srgb, var(--blue) 55%, transparent);
    background: var(--card);
    color: var(--muted);
  }

  .prose :global(blockquote p) {
    margin: 0.4rem 0;
  }

  .prose :global(table) {
    width: 100%;
    margin: 2rem 0;
    border-collapse: collapse;
    font-size: 0.94em;
    line-height: 1.7;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--line);
    text-align: left;
  }

  .prose :global(th) {
    background: var(--card);
    font-family: var(--sans);
    font-size: 0.86em;
  }

  .prose :global(figcaption) {
    margin-top: -1.2rem;
    margin-bottom: 2rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.85rem;
    text-align: center;
  }

  .prose :global(pre) {
    margin: 2rem 0;
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    background: var(--card);
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 0.88em;
    line-height: 1.7;
  }

  .prose :global(pre code) {
    padding: 0;
    border: 0;
    background: none;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3rem;
  }

  .prose :global(li) {
    margin: 0.35rem 0;
  }

  .prose :global(img) {
    margin: 2rem auto;
    border: 1px solid var(--line);
  }

  .prose :global(hr) {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .prose :global(code) {
    padding: 0.08rem 0.3rem;
    border: 1px solid var(--line);
    background: var(--card);
    font-family: var(--mono);
    font-size: 0.92em;
  }

  .related {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .related h2 {
    margin: 0.45rem 0 1.2rem;
    font-size: 1.6rem;
  }

  .related div {
    display: grid;
    gap: 0.9rem;
  }

  .related a {
    padding: 1.1rem;
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
    transition: border-color 160ms ease;
  }

  .related a:hover {
    border-color: color-mix(in srgb, var(--blue) 55%, transparent);
  }

  .related strong,
  .related span {
    display: block;
  }

  .related strong {
    font-size: 1.1rem;
    line-height: 1.45;
  }

  .related span {
    margin-top: 0.45rem;
    color: var(--muted);
    line-height: 1.7;
  }
</style>
