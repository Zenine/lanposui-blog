---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategories, publishInstant } from "../../data/blog";

export function getStaticPaths() {
  return getCategories().map(category => ({
    params: { category: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<BaseLayout title={category.name} description={`蓝破碎半圆「${category.name}」分类文章。`}>
  <main class="wrap archive">
    <p class="kicker">Category</p>
    <h1>{category.name}</h1>
    <div class="list">
      {category.posts.map(post => (
        <a class="row" href={withBase(post.href)} data-publish-at={publishInstant(post)}>
          <strong>{post.title}</strong>
          <p>{post.description}</p>
          <time datetime={post.date}>{post.date}</time>
        </a>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
  .archive {
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  h1 {
    margin: 0.5rem 0 2rem;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
  }

  .list {
    border-top: 1px solid var(--line);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 8rem;
    gap: 0.6rem 1rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 160ms ease;
  }

  .row:hover {
    border-bottom-color: color-mix(in srgb, var(--blue) 55%, transparent);
  }

  .row:hover strong {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--blue) 45%, transparent);
    text-underline-offset: 0.18em;
  }

  .row strong {
    font-size: 1.35rem;
    line-height: 1.45;
  }

  .row p {
    grid-column: 1;
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .row time {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.86rem;
  }

  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }

    .row time {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
