---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCategories, getCollections, imageDims, site, sortedPosts } from "../data/blog";

const posts = sortedPosts;
const latest = posts[0];
const latestCoverDims = latest.cover ? imageDims(latest.cover) : undefined;
const leadPost = posts[1] ?? latest;
const leadPostCoverDims = leadPost.cover ? imageDims(leadPost.cover) : undefined;
const secondaryPosts = posts.slice(2);
const categories = getCategories();
const collections = getCollections();
const recommended = posts.slice(1, 4);
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const siteLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site.url}/#website`,
      name: site.title,
      description: site.description,
      url: `${site.url}/`,
      inLanguage: "zh-CN",
      author: { "@id": `${site.url}/#author` },
    },
    {
      "@type": "Person",
      "@id": `${site.url}/#author`,
      name: site.author,
      url: "https://github.com/Zenine",
    },
  ],
};
---

<BaseLayout>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(siteLd)} />
  </Fragment>
  <main>
    <section class="wrap home-grid">
      <svg class="hero-arc" viewBox="0 0 212 110" aria-hidden="true">
        <path d="M22 100 A 78 78 0 0 1 178 100" fill="none" stroke="var(--blue)" stroke-width="1" opacity="0.3" stroke-dasharray="2 4" />
        <path class="draw" style="--d: 0ms" pathLength="100" d="M22 100 A 78 78 0 0 1 100 22" fill="none" stroke="var(--blue)" stroke-width="5" />
        <g class="drift drift-a">
          <g transform="translate(3 -8) rotate(5 123 27)">
            <path class="draw" style="--d: 140ms" pathLength="100" d="M110.9 22.8 A 78 78 0 0 1 136.6 31.1" fill="none" stroke="var(--blue)" stroke-width="5" />
          </g>
        </g>
        <g class="drift drift-b">
          <g transform="translate(10 -9) rotate(10 156 47)">
            <path class="draw" style="--d: 280ms" pathLength="100" d="M148 38.5 A 78 78 0 0 1 164.7 56.4" fill="none" stroke="var(--cyan)" stroke-width="4" />
          </g>
        </g>
        <g class="drift drift-c">
          <g transform="translate(18 -5) rotate(16 174 76)">
            <path class="draw" style="--d: 420ms" pathLength="100" d="M171.3 68.3 A 78 78 0 0 1 176.3 83.8" fill="none" stroke="var(--blue)" stroke-width="3.5" opacity="0.8" />
          </g>
        </g>
        <g class="drift drift-d">
          <g transform="translate(24 4) rotate(22 178 97)">
            <path class="draw" style="--d: 540ms" pathLength="100" d="M177.8 94.6 A 78 78 0 0 1 178 100" fill="none" stroke="var(--blue)" stroke-width="3" opacity="0.55" />
          </g>
        </g>
        <line x1="6" y1="100" x2="194" y2="100" stroke="var(--muted)" stroke-width="0.7" opacity="0.5" />
      </svg>
      <div class="intro">
        <p class="kicker">AI 时代技术决策者的判断笔记</p>
        <h1>在破碎信息里，<br />留下判断的现场。</h1>
        <p>
          这里不追逐更响的观点，只保存问题发生时的依据、边界、选择和代价。
        </p>
        <div class="hero-actions" aria-label="首页快捷入口">
          <a href={withBase("search/")}>检索文章</a>
          <a href={withBase("collections/")}>浏览合集</a>
        </div>
      </div>
      <div class="hero-panel" data-reveal>
        <a class="feature" href={withBase(latest.href)}>
          <img
            src={withBase(latest.cover)}
            alt=""
            fetchpriority="high"
            width={latestCoverDims?.width}
            height={latestCoverDims?.height}
          />
          <span>最新文章 · {latest.category}</span>
          <strong>{latest.title}</strong>
          <p>{latest.description}</p>
        </a>
        <dl class="signal">
          <div>
            <dt>Archive</dt>
            <dd>{posts.length} 篇公开文章</dd>
          </div>
          <div>
            <dt>Signal</dt>
            <dd>{categories.length} 个判断主题</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="wrap article-list" aria-labelledby="article-list-title">
      <div class="section-head">
        <p class="kicker">文章</p>
        <h2 id="article-list-title">已发布</h2>
        <a href={withBase("articles/")}>全部文章</a>
      </div>
      <div class="posts-board" data-reveal>
        <a class="lead-post" href={withBase(leadPost.href)}>
          <small>{leadPost.category} · {leadPost.collection}</small>
          <h3>{leadPost.title}</h3>
          <p>{leadPost.description}</p>
          <time datetime={leadPost.date}>{leadPost.date}</time>
          {leadPost.cover && (
            <img
              class="lead-cover"
              src={withBase(leadPost.cover)}
              alt=""
              loading="lazy"
              width={leadPostCoverDims?.width}
              height={leadPostCoverDims?.height}
            />
          )}
        </a>
        <div class="post-list">
          {secondaryPosts.map((post) => (
            <a href={withBase(post.href)}>
              <span>{post.category}</span>
              <strong>{post.title}</strong>
              <time datetime={post.date}>{post.date}</time>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="wrap discovery" aria-labelledby="discovery-title">
      <div class="section-head">
        <p class="kicker">导航</p>
        <h2 id="discovery-title">按分类阅读</h2>
      </div>
      <div class="category-strip" data-reveal>
        {categories.map(category => (
          <a href={withBase(`categories/${category.slug}/`)}>
            <strong>{category.name}</strong>
            <span>{category.posts.length} 篇</span>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap discovery" aria-labelledby="collections-title">
      <div class="section-head">
        <p class="kicker">专题</p>
        <h2 id="collections-title">合集</h2>
        <a href={withBase("collections/")}>全部合集</a>
      </div>
      <div class="collection-list" data-reveal>
        {collections.map(collection => (
          <a href={withBase(`collections/${collection.slug}/`)}>
            <small>{collection.posts.length} 篇</small>
            <strong>{collection.name}</strong>
            <span>{collection.posts.map(post => post.title).join(" / ")}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="wrap recommended" aria-labelledby="recommended-title">
      <div class="section-head">
        <p class="kicker">继续</p>
        <h2 id="recommended-title">继续读相关判断</h2>
      </div>
      <div class="rail" data-reveal>
        {recommended.map(post => (
          <a href={withBase(post.href)}>
            <time datetime={post.date}>{post.date}</time>
            <strong>{post.title}</strong>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    padding-bottom: 5rem;
  }

  .home-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    min-height: min(680px, calc(100vh - 7rem));
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .hero-arc {
    position: absolute;
    bottom: -2px;
    left: 50%;
    /* 不用负 z-index:body 有实底背景,负层级子元素会被 body 背景盖住;
       DOM 顺序保证弧画在 .intro/.hero-panel 之下 */
    z-index: 0;
    width: min(720px, 82%);
    opacity: 0.5;
    pointer-events: none;
    transform: translateX(-50%);
  }

  .hero-arc .drift {
    transform-box: fill-box;
    transform-origin: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-arc .draw {
      stroke-dasharray: 100;
      stroke-dashoffset: 100;
      animation: arc-draw 880ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
      animation-delay: var(--d, 0ms);
    }

    .hero-arc .drift-a {
      animation: drift-a 2.8s ease-in-out 1.2s infinite alternate;
    }

    .hero-arc .drift-b {
      animation: drift-b 2.3s ease-in-out 1.5s infinite alternate;
    }

    .hero-arc .drift-c {
      animation: drift-c 3.1s ease-in-out 1.8s infinite alternate;
    }

    .hero-arc .drift-d {
      animation: drift-d 2.5s ease-in-out 2s infinite alternate;
    }
  }

  @keyframes arc-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drift-a {
    to {
      transform: translate(1.4px, -1px) rotate(0.5deg);
    }
  }

  @keyframes drift-b {
    to {
      transform: translate(-1.2px, 1px) rotate(-0.45deg);
    }
  }

  @keyframes drift-c {
    to {
      transform: translate(1px, 1.4px) rotate(0.4deg);
    }
  }

  @keyframes drift-d {
    to {
      transform: translate(-1px, -0.8px) rotate(-0.35deg);
    }
  }

  .intro,
  .hero-panel {
    position: relative;
  }

  h1 {
    margin: 0.8rem 0 1.2rem;
    max-width: 640px;
    font-size: clamp(2.35rem, 4.7vw, 4.35rem);
    line-height: 1.04;
    letter-spacing: 0;
  }

  .intro p:last-child {
    max-width: 560px;
    color: var(--muted);
    font-size: 1.18rem;
    line-height: 1.85;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.7rem;
    font-family: var(--sans);
    font-size: 0.86rem;
  }

  .hero-actions a {
    padding: 0.58rem 0.8rem;
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .hero-actions a:hover {
    border-color: color-mix(in srgb, var(--blue) 60%, transparent);
    color: var(--blue);
  }

  .hero-panel {
    position: relative;
    display: grid;
    gap: 0.85rem;
  }

  .feature {
    display: block;
    position: relative;
    padding: 0.95rem;
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
    box-shadow: var(--shadow-feature);
  }

  .feature img {
    aspect-ratio: 1.82;
    width: 100%;
    height: clamp(12rem, 28vh, 18rem);
    object-fit: cover;
    border: 1px solid var(--line);
  }

  .feature span,
  .feature strong {
    display: block;
  }

  .feature span {
    margin-top: 1rem;
    color: var(--blue);
    font-family: var(--sans);
    font-size: 0.78rem;
    font-weight: 700;
  }

  .feature strong {
    margin-top: 0.35rem;
    font-size: 1.35rem;
    line-height: 1.35;
  }

  .feature p {
    margin: 0.7rem 0 0;
    color: var(--muted);
    line-height: 1.7;
  }

  .signal {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .signal div {
    padding: 0.9rem 1rem;
    background: var(--card);
  }

  .signal dt,
  .signal dd {
    margin: 0;
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  .signal dt {
    color: var(--blue);
    font-weight: 700;
  }

  .signal dd {
    margin-top: 0.35rem;
    color: var(--muted);
  }

  .article-list {
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .section-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .section-head > a {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.86rem;
    text-decoration: none;
  }

  h2 {
    margin: 0;
    font-size: 2rem;
  }

  .posts-board {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .lead-post,
  .post-list a {
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
  }

  .lead-post {
    display: flex;
    flex-direction: column;
    min-height: 22rem;
    padding: 1.45rem;
  }

  .lead-post small,
  .lead-post time,
  .post-list span,
  .post-list time {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.82rem;
  }

  .lead-post h3 {
    margin: 4.8rem 0 1rem;
    font-size: clamp(1.85rem, 4vw, 3rem);
    line-height: 1.18;
  }

  .lead-post p {
    color: var(--muted);
    line-height: 1.75;
  }

  .lead-post time {
    display: block;
    margin-top: 1.5rem;
  }

  .lead-cover {
    aspect-ratio: 1.82;
    width: 100%;
    height: clamp(15rem, 30vw, 25rem);
    margin-top: auto;
    border: 1px solid var(--line);
    object-fit: cover;
  }

  .post-list {
    display: grid;
    gap: 0.75rem;
  }

  .post-list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 6.4rem;
    gap: 0.5rem 1rem;
    align-content: center;
    min-height: 7.6rem;
    padding: 1rem 1.1rem;
  }

  .post-list span,
  .post-list strong {
    grid-column: 1;
  }

  .post-list strong {
    font-size: 1.22rem;
    line-height: 1.45;
  }

  .post-list time {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .discovery,
  .recommended {
    padding-top: 3.4rem;
  }

  .category-strip {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .category-strip a {
    min-height: 7.2rem;
    padding: 1rem;
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
  }

  .category-strip strong,
  .category-strip span,
  .rail time,
  .rail strong {
    display: block;
  }

  .category-strip strong {
    font-size: 1.2rem;
  }

  .category-strip span,
  .rail time {
    margin-top: 0.75rem;
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.7;
  }

  .collection-list {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.4rem;
  }

  .collection-list a {
    display: grid;
    grid-template-columns: 5rem minmax(10rem, 0.32fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 1.05rem 1.1rem;
    border: 1px solid var(--line);
    background: var(--card);
    text-decoration: none;
  }

  .collection-list small,
  .collection-list span {
    color: var(--muted);
    font-family: var(--sans);
    font-size: 0.82rem;
    line-height: 1.65;
  }

  .collection-list strong {
    font-size: 1.2rem;
  }

  .rail {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 1.4rem;
  }

  .rail strong {
    margin-top: 1.1rem;
    font-size: 1.2rem;
    line-height: 1.45;
  }

  .feature,
  .lead-post,
  .post-list a,
  .category-strip a,
  .collection-list a {
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .feature:hover,
  .lead-post:hover,
  .post-list a:hover,
  .category-strip a:hover,
  .collection-list a:hover {
    border-color: color-mix(in srgb, var(--blue) 55%, transparent);
    box-shadow: var(--shadow-hover);
  }

  @media (prefers-reduced-motion: no-preference) {
    .feature:hover,
    .lead-post:hover,
    .post-list a:hover,
    .category-strip a:hover,
    .collection-list a:hover {
      transform: translateY(-2px);
    }
  }

  .rail a strong {
    text-decoration: none;
  }

  .rail a:hover strong {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--blue) 55%, transparent);
    text-underline-offset: 0.18em;
  }

  @media (max-width: 760px) {
    .home-grid,
    .posts-board,
    .category-strip,
    .collection-list a,
    .rail {
      grid-template-columns: 1fr;
    }

    .home-grid {
      min-height: auto;
      padding-top: 1rem;
      padding-bottom: 3rem;
    }

    .hero-arc {
      width: 100%;
      opacity: 0.32;
    }

    h1 {
      max-width: 9.2em;
      font-size: clamp(2.05rem, 8.8vw, 2.75rem);
      line-height: 1.12;
    }

    .feature {
      box-shadow: var(--shadow-feature);
    }

    .signal,
    .post-list a {
      grid-template-columns: 1fr;
    }

    .post-list time {
      grid-column: 1;
      grid-row: auto;
    }
  }
</style>
