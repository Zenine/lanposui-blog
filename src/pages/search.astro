---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
---

<BaseLayout title="检索" description="检索蓝破碎半圆已发布文章。">
  <Fragment slot="head">
    <link rel="stylesheet" href={withBase("pagefind/pagefind-ui.css")} />
    <script is:inline define:vars={{ pagefindUiPath: withBase("pagefind/pagefind-ui.js") }}>
      const initPagefind = () => {
        const target = document.querySelector("#search");
        if (!target || target.dataset.pagefindReady) return;
        target.dataset.pagefindReady = "1";
        const mount = () => {
          new PagefindUI({
            element: "#search",
            showSubResults: true,
            pageSize: 8,
            translations: {
              placeholder: "检索文章标题、正文或主题",
              clear_search: "清除",
              load_more: "加载更多",
              search_label: "站内检索",
              zero_results: "没有找到匹配文章。",
              many_results: "[COUNT] 条结果",
              one_result: "1 条结果",
            },
          });
        };
        if (window.PagefindUI) {
          mount();
          return;
        }
        const script = document.createElement("script");
        script.src = pagefindUiPath;
        script.onload = mount;
        document.head.append(script);
      };
      document.addEventListener("astro:page-load", initPagefind);
    </script>
  </Fragment>
  <main class="wrap search-page">
    <p class="kicker">Search</p>
    <h1>检索</h1>
    <div id="search"></div>
  </main>
</BaseLayout>

<style>
  .search-page {
    padding-top: 3rem;
    padding-bottom: 6rem;
  }

  h1 {
    margin: 0.5rem 0 2rem;
    font-size: clamp(3rem, 7vw, 6rem);
    line-height: 1;
  }

  #search {
    max-width: 780px;
    --pagefind-ui-primary: var(--blue);
    --pagefind-ui-text: var(--ink);
    --pagefind-ui-background: var(--card-solid);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-font: inherit;
  }
</style>
